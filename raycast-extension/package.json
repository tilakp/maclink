{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "maclink",
  "title": "maclink",
  "description": "Search, open, and copy your maclink deep links",
  "icon": "extension-icon.png",
  "author": "tilakp",
  "categories": [
    "Productivity",
    "System"
  ],
  "license": "MIT",
  "commands": [
    {
      "name": "search-links",
      "title": "Search Links",
      "subtitle": "maclink",
      "description": "Search your captured maclink deep links",
      "mode": "view",
      "icon": "command-icon.png"
    }
  ],
  "dependencies": {
    "@raycast/api": "^1.94.0",
    "@raycast/utils": "^1.19.1"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^1.0.11",
    "@types/node": "22.13.10",
    "@types/react": "19.0.10",
    "eslint": "^8.57.0",
    "prettier": "^3.3.3",
    "typescript": "^5.4.5"
  },
  "scripts": {
    "build": "ray build",
    "dev": "ray develop",
    "lint": "ray lint",
    "typecheck": "tsc --noEmit"
  }
}
