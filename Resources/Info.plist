<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleName</key>
    <string>maclink</string>
    <key>CFBundleDisplayName</key>
    <string>maclink</string>
    <key>CFBundleIdentifier</key>
    <string>com.tilak.maclink</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>CFBundleShortVersionString</key>
    <string>0.1.0</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleExecutable</key>
    <string>maclink</string>
    <key>LSMinimumSystemVersion</key>
    <string>14.0</string>

    <!-- Menu-bar-only: no Dock icon, no app switcher entry. -->
    <key>LSUIElement</key>
    <true/>

    <!-- Required or the automation TCC prompt is suppressed and Apple Events
         silently fail (spec §3.4). -->
    <key>NSAppleEventsUsageDescription</key>
    <string>maclink uses automation to read what you have selected in Finder, Mail, and your browser, and to reopen those items later.</string>

    <!-- Registers the maclink:// scheme with Launch Services (spec §6.3). -->
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleURLName</key>
            <string>com.tilak.maclink.url</string>
            <key>CFBundleTypeRole</key>
            <string>Viewer</string>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>maclink</string>
            </array>
        </dict>
    </array>
</dict>
</plist>
